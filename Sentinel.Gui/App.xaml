<Application x:Class="Sentinel.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Palette tuned to Burp Suite: neutral dark grey ground with the vivid Burp
             orange (#FF6633) as the interaction accent, and bright traffic-light health hues. -->
        <SolidColorBrush x:Key="Bg"        Color="#232629" />
        <SolidColorBrush x:Key="Panel"     Color="#2B2F33" />
        <SolidColorBrush x:Key="Card"      Color="#31353A" />
        <SolidColorBrush x:Key="CardAlt"   Color="#2A2E32" />
        <SolidColorBrush x:Key="Line"      Color="#3D434A" />
        <SolidColorBrush x:Key="Text"      Color="#ECEEF0" />
        <SolidColorBrush x:Key="Muted"     Color="#AAB2BB" />
        <SolidColorBrush x:Key="Faint"     Color="#727B85" />

        <!-- Interaction / brand: the vivid Burp orange. -->
        <SolidColorBrush x:Key="Brand"     Color="#FF6633" />
        <SolidColorBrush x:Key="BrandDeep" Color="#3E2415" />

        <!-- Bright health signals. -->
        <SolidColorBrush x:Key="Green"     Color="#2FD07A" />
        <SolidColorBrush x:Key="GreenTint" Color="#12331F" />
        <SolidColorBrush x:Key="Amber"     Color="#FFC53D" />
        <SolidColorBrush x:Key="AmberTint" Color="#3A2E0F" />
        <SolidColorBrush x:Key="Red"       Color="#FF5252" />
        <SolidColorBrush x:Key="RedTint"   Color="#3A1A1A" />

        <!-- Process-type colouring + new-process flash. -->
        <SolidColorBrush x:Key="ServiceText" Color="#C792EA" />
        <SolidColorBrush x:Key="NewTint"     Color="#12331F" />

        <!-- Live graph fills. -->
        <SolidColorBrush x:Key="CpuFill" Color="#2EFF6633" />
        <SolidColorBrush x:Key="MemFill" Color="#2EFFC53D" />
        <SolidColorBrush x:Key="NetFill" Color="#2E4FC3F7" />
        <SolidColorBrush x:Key="NetIn"   Color="#4FC3F7" />
        <SolidColorBrush x:Key="NetOut"  Color="#2FD07A" />

        <FontFamily x:Key="Ui">Segoe UI</FontFamily>
    </Application.Resources>
</Application>
