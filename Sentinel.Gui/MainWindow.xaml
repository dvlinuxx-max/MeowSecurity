<Window x:Class="Sentinel.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sentinel.Gui"
        Title="Sentinel" Height="840" Width="1320" MinHeight="640" MinWidth="1040"
        FlowDirection="RightToLeft" FontFamily="{StaticResource Ui}"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Sidebar nav item -->
        <Style TargetType="RadioButton" x:Key="NavItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Border x:Name="bar" Width="3" HorizontalAlignment="Right" Height="16"
                                        CornerRadius="2" Background="Transparent" Margin="0,0,-11,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Card}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrandDeep}" />
                                <Setter TargetName="bar" Property="Background" Value="{StaticResource Brand}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin meter (CPU / memory) -->
        <Style TargetType="ProgressBar" x:Key="Meter">
            <Setter Property="Height" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource Brand}" />
            <Setter Property="Background" Value="{StaticResource Line}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" HorizontalAlignment="Left" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button (pause) -->
        <Style TargetType="Button" x:Key="Ghost">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource Card}" CornerRadius="7"
                                Padding="16,8" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brand}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grids (shared by all three tables) -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="HorizontalGridLinesBrush" Value="#1A2331" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandDeep}" />
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{Binding RowHighlight}" />
        </Style>

        <!-- Dark tooltip (path + command line on hover) -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="MaxWidth" Value="560" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Dark context menu -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="5" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="14,7">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Card}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="216" />
        </Grid.ColumnDefinitions>

        <!-- ======================= SIDEBAR (right, RTL) ======================= -->
        <Border Grid.Column="1" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,20,26">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource BrandDeep}"
                            Margin="0,0,12,0">
                        <TextBlock Text="◆" Foreground="{StaticResource Brand}" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sentinel" Foreground="{StaticResource Text}" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="مراقبة حيّة" Foreground="{StaticResource Faint}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavOverview" GroupName="nav" Style="{StaticResource NavItem}"
                                 Content="نظرة عامة" IsChecked="True" Checked="OnNav" Tag="overview" />
                    <RadioButton x:Name="NavProcesses" GroupName="nav" Style="{StaticResource NavItem}"
                                 Content="العمليات" Checked="OnNav" Tag="processes" />
                    <RadioButton x:Name="NavNetwork" GroupName="nav" Style="{StaticResource NavItem}"
                                 Content="الشبكة" Checked="OnNav" Tag="network" />
                    <RadioButton x:Name="NavAutoruns" GroupName="nav" Style="{StaticResource NavItem}"
                                 Content="بدء التشغيل" Checked="OnNav" Tag="autoruns" />
                    <RadioButton x:Name="NavThreats" GroupName="nav" Style="{StaticResource NavItem}"
                                 Content="التهديدات" Checked="OnNav" Tag="threats" />
                </StackPanel>

                <!-- Live indicator -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="24,0,24,22">
                    <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="{StaticResource Green}"
                             VerticalAlignment="Center" Margin="0,0,9,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.25" Duration="0:0:1.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="LiveLabel" Text="المراقبة نشطة" Foreground="{StaticResource Muted}"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= CONTENT ======================= -->
        <Grid Grid.Column="0">

            <!-- === OVERVIEW === -->
            <Grid x:Name="PageOverview" Margin="28,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hero status band with live pulse -->
                <Border Grid.Row="0" Background="{StaticResource Card}" CornerRadius="14"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="26,22">
                    <Grid>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="HeroTitle" Text="جارٍ بدء المراقبة…"
                                       Foreground="{StaticResource Text}" FontSize="26" FontWeight="Bold" />
                            <TextBlock x:Name="HeroSub" Text="نفحص العمليات وتواقيعها وذاكرتها واتصالاتها"
                                       Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />
                        </StackPanel>
                        <local:Sparkline x:Name="HeroPulse" Width="260" Height="60"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Live readouts (four distinct treatments, not identical cards) -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU: number + meter -->
                    <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="12"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18,16">
                        <StackPanel FlowDirection="LeftToRight">
                            <TextBlock Text="المعالج" Foreground="{StaticResource Muted}" FontSize="12.5"
                                       HorizontalAlignment="Right" />
                            <TextBlock x:Name="CpuBig" Text="0%" Foreground="{StaticResource Text}"
                                       FontSize="30" FontWeight="Bold" Margin="0,4,0,12" HorizontalAlignment="Right" />
                            <ProgressBar x:Name="CpuMeter" Style="{StaticResource Meter}"
                                         Foreground="{StaticResource Brand}" Value="0" />
                        </StackPanel>
                    </Border>

                    <!-- Memory: number + sub + meter -->
                    <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="12"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18,16">
                        <StackPanel FlowDirection="LeftToRight">
                            <Grid>
                                <TextBlock Text="الذاكرة" Foreground="{StaticResource Muted}" FontSize="12.5"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="MemDetail" Text="" Foreground="{StaticResource Faint}"
                                           FontSize="11.5" HorizontalAlignment="Left" />
                            </Grid>
                            <TextBlock x:Name="MemBig" Text="0%" Foreground="{StaticResource Text}"
                                       FontSize="30" FontWeight="Bold" Margin="0,4,0,12" HorizontalAlignment="Right" />
                            <ProgressBar x:Name="MemMeter" Style="{StaticResource Meter}"
                                         Foreground="{StaticResource Amber}" Value="0" />
                        </StackPanel>
                    </Border>

                    <!-- Network: down/up + wave -->
                    <Border Grid.Column="4" Background="{StaticResource Card}" CornerRadius="12"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18,16">
                        <Grid FlowDirection="LeftToRight">
                            <StackPanel>
                                <TextBlock Text="الشبكة" Foreground="{StaticResource Muted}" FontSize="12.5" />
                                <TextBlock x:Name="NetDown" Text="↓ 0" Foreground="{StaticResource NetIn}"
                                           FontSize="19" FontWeight="Bold" Margin="0,6,0,0" />
                                <TextBlock x:Name="NetUp" Text="↑ 0" Foreground="{StaticResource NetOut}"
                                           FontSize="19" FontWeight="Bold" Margin="0,2,0,0" />
                            </StackPanel>
                            <local:Sparkline x:Name="NetSpark" Height="42" VerticalAlignment="Bottom"
                                             Margin="0,26,0,0" />
                        </Grid>
                    </Border>

                    <!-- Processes: big count -->
                    <Border Grid.Column="6" Background="{StaticResource Card}" CornerRadius="12"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18,16">
                        <StackPanel FlowDirection="LeftToRight">
                            <TextBlock Text="العمليات النشطة" Foreground="{StaticResource Muted}" FontSize="12.5"
                                       HorizontalAlignment="Right" />
                            <TextBlock x:Name="ProcBig" Text="0" Foreground="{StaticResource Text}"
                                       FontSize="30" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Right" />
                            <TextBlock x:Name="ThreadSub" Text="" Foreground="{StaticResource Faint}"
                                       FontSize="11.5" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Attention list -->
                <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="12" Margin="0,16,0,0"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid Margin="22,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="يحتاج انتباهك" Foreground="{StaticResource Text}"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="AttentionEmpty" Grid.Row="1" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Foreground="{StaticResource Faint}" FontSize="13"
                                   Text="لا شيء يحتاج انتباهك الآن — كل العمليات موقّعة ولا كود محقون." />
                        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AttentionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Tint}" CornerRadius="9" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Accent}"
                                                             VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}"
                                                               FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Reasons}" Foreground="{StaticResource Muted}"
                                                               FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding VerdictText}" Foreground="{Binding Accent}"
                                                           FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- === PROCESSES === -->
            <Grid x:Name="PageProcesses" Margin="28,26" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="العمليات الحيّة" Foreground="{StaticResource Text}"
                               FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Background="{StaticResource Card}" CornerRadius="7" Width="230"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,0" Margin="0,0,10,0">
                            <Grid>
                                <TextBlock x:Name="SearchHint" Text="ابحث باسم العملية أو رقمها…"
                                           Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                           IsHitTestVisible="False" FontSize="12.5" />
                                <TextBox x:Name="Search" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                         CaretBrush="{StaticResource Brand}" FontSize="12.5" Height="32"
                                         TextChanged="OnSearchChanged" />
                            </Grid>
                        </Border>
                        <Button x:Name="PauseButton" Content="إيقاف مؤقّت" Style="{StaticResource Ghost}"
                                Click="OnPauseToggle" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="12"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6,2">
                    <DataGrid x:Name="Grid">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="إيقاف مؤقّت" Click="OnSuspendProcess" />
                                <MenuItem Header="استئناف" Click="OnResumeProcess" />
                                <MenuItem Header="إنهاء العملية" Click="OnKillProcess"
                                          Foreground="{StaticResource Red}" />
                                <MenuItem Header="فتح موقع الملف" Click="OnOpenLocation" />
                                <MenuItem Header="نسخ الاسم" Click="OnCopyName" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="الحالة" Width="82" SortMemberPath="Verdict">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Tint}" CornerRadius="5" Padding="9,2"
                                                HorizontalAlignment="Right" Margin="4,0">
                                            <TextBlock Text="{Binding VerdictText}" Foreground="{Binding Accent}"
                                                       FontWeight="Bold" FontSize="11.5" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="العملية" Binding="{Binding Name}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding NameColor}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60" SortMemberPath="Pid" />
                            <DataGridTextColumn Header="المعالج" Binding="{Binding Cpu}" Width="70" SortMemberPath="CpuValue">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brand}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الذاكرة" Binding="{Binding PrivateText}" Width="84" SortMemberPath="PrivateBytes" />
                            <DataGridTextColumn Header="خيوط" Binding="{Binding Threads}" Width="54" SortMemberPath="Threads" />
                            <DataGridTextColumn Header="إدخال/إخراج" Binding="{Binding Io}" Width="90" SortMemberPath="IoValue" />
                            <DataGridTextColumn Header="الشبكة" Binding="{Binding Network}" Width="90" SortMemberPath="RemoteConns" />
                            <DataGridTextColumn Header="التوقيع" Binding="{Binding Signature}" Width="86" />
                            <DataGridTextColumn Header="الناشر" Binding="{Binding Publisher}" Width="196" />
                            <DataGridTextColumn Header="السبب" Binding="{Binding Reasons}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- === NETWORK === -->
            <Grid x:Name="PageNetwork" Margin="28,26" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="حركة الشبكة" Foreground="{StaticResource Text}"
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,0,16" />

                <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="12"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="22,18" Height="150">
                    <Grid FlowDirection="LeftToRight">
                        <StackPanel VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NetDownBig" Text="↓ 0" Foreground="{StaticResource NetIn}"
                                           FontSize="22" FontWeight="Bold" Margin="0,0,18,0" />
                                <TextBlock x:Name="NetUpBig" Text="↑ 0" Foreground="{StaticResource NetOut}"
                                           FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="عبر كل الواجهات النشطة" Foreground="{StaticResource Faint}"
                                       FontSize="11.5" Margin="0,4,0,0" />
                        </StackPanel>
                        <local:Sparkline x:Name="NetBigGraph" VerticalAlignment="Stretch" Margin="0,8,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="12" Margin="0,16,0,0"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6,2">
                    <DataGrid x:Name="NetGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="العملية" Binding="{Binding Name}" Width="230">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding NameColor}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="66" />
                            <DataGridTextColumn Header="الاتصالات" Binding="{Binding Network}" Width="120" SortMemberPath="RemoteConns" />
                            <DataGridTextColumn Header="التوقيع" Binding="{Binding Signature}" Width="100" />
                            <DataGridTextColumn Header="الناشر" Binding="{Binding Publisher}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- === AUTORUNS === -->
            <Grid x:Name="PageAutoruns" Margin="28,26" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="بدء التشغيل" Foreground="{StaticResource Text}"
                                   FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="ما يشغّله ويندوز تلقائياً عند الإقلاع — حيث تختبئ البرمجيات للبقاء"
                                   Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="AutorunSummary" Text="" Foreground="{StaticResource Muted}"
                                   FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button x:Name="AutorunScanBtn" Content="فحص" Style="{StaticResource Ghost}"
                                Click="OnScanAutoruns" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="12"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6,2">
                    <Grid>
                        <TextBlock x:Name="AutorunHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Faint}" FontSize="13.5"
                                   Text="اضغط فحص لعرض كل ما يبدأ تلقائياً مع النظام." />
                        <DataGrid x:Name="AutorunGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="الحالة" Width="86" SortMemberPath="Verdict">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Tint}" CornerRadius="5" Padding="9,2"
                                                    HorizontalAlignment="Right" Margin="4,0">
                                                <TextBlock Text="{Binding VerdictText}" Foreground="{Binding Accent}"
                                                           FontWeight="Bold" FontSize="11.5" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="170">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الموقع" Binding="{Binding Location}" Width="130" />
                                <DataGridTextColumn Header="التوقيع" Binding="{Binding SignatureText}" Width="86" />
                                <DataGridTextColumn Header="الناشر" Binding="{Binding Publisher}" Width="180" />
                                <DataGridTextColumn Header="المسار" Binding="{Binding Path}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- === THREATS === -->
            <Grid x:Name="PageThreats" Margin="28,26" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="التهديدات والعناصر المشبوهة" Foreground="{StaticResource Text}"
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,0,16" />
                <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="12"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6,2">
                    <Grid>
                        <TextBlock x:Name="ThreatsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Faint}" FontSize="13.5"
                                   Text="لا تهديدات. كل العمليات موقّعة، ولا كود محقون، ولا عملية مخفية." />
                        <DataGrid x:Name="ThreatGrid">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="إنهاء العملية" Click="OnKillProcess"
                                              Foreground="{StaticResource Red}" />
                                    <MenuItem Header="فتح موقع الملف" Click="OnOpenLocation" />
                                    <MenuItem Header="نسخ الاسم" Click="OnCopyName" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="الحالة" Width="90" SortMemberPath="Verdict">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Tint}" CornerRadius="5" Padding="9,2"
                                                    HorizontalAlignment="Right" Margin="4,0">
                                                <TextBlock Text="{Binding VerdictText}" Foreground="{Binding Accent}"
                                                           FontWeight="Bold" FontSize="11.5" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="العملية" Binding="{Binding Name}" Width="210">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="66" />
                                <DataGridTextColumn Header="التوقيع" Binding="{Binding Signature}" Width="110" />
                                <DataGridTextColumn Header="الناشر" Binding="{Binding Publisher}" Width="190" />
                                <DataGridTextColumn Header="السبب" Binding="{Binding Reasons}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
