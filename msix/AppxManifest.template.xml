<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{IDENTITY_NAME}"
    Publisher="{PUBLISHER}"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Meow Security</DisplayName>
    <PublisherDisplayName>{PUBLISHER_DISPLAY_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 1903 is the floor for a packaged full-trust app to delete files under AppData, and the
         floor this product's own documentation assumes. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ar" />
    <Resource Language="en" />
  </Resources>

  <Applications>
    <Application Id="MeowSecurity"
                 Executable="MeowSecurity\MeowSecurity.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Meow Security"
        Description="مراقب العمليات والذاكرة والشبكة، وكاشف اختراق للجهاز. يعمل دون اتصال بالكامل."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Meow Security" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The application itself runs at the invoker's privileges and always will. runFullTrust is
         what lets a desktop application be packaged at all. -->
    <rescap:Capability Name="runFullTrust" />

    <!-- Restricted, and refused by default. It permits this package to start ONE separate
         process — MeowSecurity.Engine — elevated through the runas verb and the standard
         Windows consent prompt. It is not a way for this application to elevate itself, and it
         is not used for anything else.
         The justification submitted with this package is STORE-JUSTIFICATION.md in the source
         repository, which is public and answers each of the five points the certification team
         asks. See PACKAGING.md for the summary that goes in the Partner Center field. -->
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
